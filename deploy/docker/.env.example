# =============================================================================
# SuperMarket POS - Local Docker Environment Template (.env.example)
# Copy this file to '.env' and set your own secure passwords locally.
# Example: cp .env.example .env
# =============================================================================

# 1. PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# 2. Keycloak IAM Configuration
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_secure_keycloak_admin_password_here
KEYCLOAK_HTTP_PORT=8080

# 3. Redis In-Memory Store
REDIS_PORT=6379

# 4. RabbitMQ Message Broker
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=your_secure_rabbitmq_password_here
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# 5. LocalStack (S3 Emulator)
LOCALSTACK_PORT=4566

# 6. Observability
JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9090

# 7. Database Web Management
ADMINER_PORT=8888

# 8. .NET Microservices Connection Strings (For local CLI & tools)
IDENTITY_DB_CONNECTION=Host=localhost;Port=5432;Database=identity_db;Username=postgres;Password=your_secure_postgres_password_here;
